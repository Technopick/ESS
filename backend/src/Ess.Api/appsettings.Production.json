{
  "Database": { "MigrateOnStartup": false },
  "Swagger": { "Enabled": false },
  "NavIntegration": { "AllowSimulator": false },
  "Serilog": {
    "MinimumLevel": { "Default": "Information" },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" } },
      { "Name": "File", "Args": { "path": "logs/ess-.json", "rollingInterval": "Day", "retainedFileCountLimit": 90,
        "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  }
}
