<?xml version="1.0" encoding="utf-8"?>
<!-- IIS settings for the ESS portal. The publish step fills in processPath and arguments. Secrets never go in this file:
     they are environment variables on the application pool (see deploy/windows/Install-EssPortal.ps1). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- The WebDAV module, when that IIS feature is installed, answers PUT and DELETE itself with 405 before the portal sees them. -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- ASPNETCORE_ENVIRONMENT is set on the application pool (Production or UAT); unset means Production.
           A value here would override the pool's. -->
      <aspNetCore processPath="dotnet" arguments=".\Ess.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <!-- SignalR (live notifications) uses the IIS WebSocket Protocol feature, which setup enables. No <webSocket> element here:
           IIS locks that section by default (HTTP 500.19, 0x80070021) and it is on server-wide once the feature is installed. -->
      <security>
        <!-- Documents are limited to 10 MB by the API; allow a little more for the multipart envelope. -->
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="26214400" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
