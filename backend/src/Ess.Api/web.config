<?xml version="1.0" encoding="utf-8"?>
<!-- IIS settings for the ESS portal. The publish step fills in processPath and arguments. Secrets never go in this file:
     they are environment variables on the application pool (see deploy/windows/Install-EssPortal.ps1). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Ess.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- SignalR (live notifications) needs the IIS WebSocket Protocol feature. -->
      <webSocket enabled="true" />
      <security>
        <!-- Documents are limited to 10 MB by the API; allow a little more for the multipart envelope. -->
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="26214400" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
