{
  "ConnectionStrings": {
    "Ess": "Host=localhost;Port=5432;Database=ess;Username=ess_app;Password=SET_VIA_ENVIRONMENT;Maximum Pool Size=100"
  },
  "Jwt": {
    "Issuer": "ess-portal",
    "Audience": "ess-portal",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "Origins": []
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Hosting": {
    "RunBackgroundWorkers": true,
    "HangfireWorkers": 5
  },
  "Swagger": {
    "Enabled": false
  },
  "NavIntegration": {
    "QueueBatchSize": 20,
    "QueuePollSeconds": 10,
    "QueueLockSeconds": 120,
    "RetryBaseDelaySeconds": 15,
    "RetryMaxDelayMinutes": 60,
    "LogBodyMaxChars": 8000,
    "LogRetentionDays": 180,
    "AdditionalSensitiveFields": [],
    "AllowSimulator": false,
    "SyncCron": "*/15 * * * *",
    "FullSyncCron": "30 1 * * *"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "App": {
    "Name": "ESS Portal",
    "PublicUrl": "https://ess.example.invalid"
  },
  "Security": {
    "RequireMfaForRoles": [
      "SystemAdministrator",
      "IntegrationAdministrator",
      "HrManager",
      "FinanceManager"
    ],
    "EnforceRoleMfa": true
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "no-reply@example.invalid",
    "FromName": "Employee Self-Service",
    "LogOnly": false
  },
  "Sms": {
    "Provider": "None",
    "Username": "",
    "ApiKey": "",
    "SenderId": "",
    "DefaultCountryCode": "254"
  },
  "Reporting": {
    "FontPath": "",
    "BoldFontPath": ""
  }
}
