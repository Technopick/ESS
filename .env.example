# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SIGNING_KEY=
ESS_ENVIRONMENT=Production
MIGRATE_ON_STARTUP=true
# First start only: creates the initial administrator when no users exist. Remove afterwards.
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASSWORD=
# SMS gateway (optional). Provider: None, Log (writes to the log only), MobileSasa or AfricasTalking.
# Mobile Sasa: SMS_API_KEY is the API token (starts with mbs_) and SMS_SENDER_ID the approved sender name.
SMS_PROVIDER=None
SMS_API_KEY=
SMS_SENDER_ID=
# Africa's Talking only
SMS_USERNAME=
